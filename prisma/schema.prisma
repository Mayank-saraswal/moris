// Moris Database Schema — Supabase PostgreSQL via Prisma

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  language  String   @default("typescript")
  framework String?
  settings  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  files         File[]
  conversations Conversation[]

  @@index([userId])
  @@map("projects")
}

model File {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  name      String
  path      String
  type      String // "file" | "folder"
  language  String?
  blobPath  String?  @map("blob_path")
  size      Int?     @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, path])
  @@map("files")
}

model Conversation {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([projectId])
  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String // "user" | "assistant"
  content        String
  status         String   @default("completed")
  model          String?
  thinking       String?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model UserSubscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique @map("user_id")
  plan                   String    @default("free")
  razorpayCustomerId     String?   @map("razorpay_customer_id")
  razorpaySubscriptionId String?   @map("razorpay_subscription_id")
  tokenBalance           BigInt    @default(500000) @map("token_balance")
  monthlyTokenLimit      BigInt    @default(500000) @map("monthly_token_limit")
  tokensUsedThisPeriod   BigInt    @default(0) @map("tokens_used_this_period")
  billingPeriodStart     DateTime? @map("billing_period_start")
  billingPeriodEnd       DateTime? @map("billing_period_end")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  tokenUsage     TokenUsage[]
  tokenPurchases TokenPurchase[]

  @@map("user_subscriptions")
}

model TokenUsage {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  projectId          String?  @map("project_id")
  action             String
  model              String
  promptTokens       Int      @map("prompt_tokens")
  completionTokens   Int      @map("completion_tokens")
  morisTokensCharged BigInt   @map("moris_tokens_charged")
  multiplier         Float    @default(1.0)
  createdAt          DateTime @default(now()) @map("created_at")

  subscription UserSubscription @relation(fields: [userId], references: [userId])

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, projectId])
  @@map("token_usage")
}

model TokenPurchase {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  razorpayPaymentId String?  @map("razorpay_payment_id")
  tokensPurchased   BigInt   @map("tokens_purchased")
  amountPaid        Int      @map("amount_paid")
  currency          String   @default("INR")
  createdAt         DateTime @default(now()) @map("created_at")

  subscription UserSubscription @relation(fields: [userId], references: [userId])

  @@map("token_purchases")
}
